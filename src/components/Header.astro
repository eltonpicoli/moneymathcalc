---
export interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const loanCalcs = [
  { href: '/mortgage-calculator',   label: 'Mortgage Calculator' },
  { href: '/loan-calculator',       label: 'Loan Calculator' },
  { href: '/auto-loan-calculator',  label: 'Auto Loan Calculator' },
  { href: '/amortization-calculator', label: 'Amortization Calculator' },
  { href: '/payment-calculator',    label: 'Payment Calculator' },
];

const savingsCalcs = [
  { href: '/compound-interest-calculator', label: 'Compound Interest Calculator' },
  { href: '/investment-calculator',        label: 'Investment Calculator' },
  { href: '/retirement-calculator',        label: 'Retirement Calculator' },
];

const incomeCalcs = [
  { href: '/salary-calculator',     label: 'Salary Calculator' },
  { href: '/income-tax-calculator', label: 'Income Tax Calculator' },
];

const isCalcActive = [...loanCalcs, ...savingsCalcs, ...incomeCalcs]
  .some(c => currentPath.startsWith(c.href));
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-40">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2 hover:opacity-80 transition">
        <div class="w-8 h-8 bg-primary-600 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <line x1="12" y1="2" x2="12" y2="22"/>
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
          </svg>
        </div>
        <span class="font-bold text-xl text-gray-900">MoneyMathCalc</span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden md:flex items-center space-x-1">
        <a
          href="/"
          class={`px-4 py-2 rounded-md text-sm font-medium transition ${isActive('/') ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-50 hover:text-gray-900'}`}
        >
          Home
        </a>

        <!-- Calculators dropdown -->
        <div class="relative group">
          <button
            class={`px-4 py-2 rounded-md text-sm font-medium transition flex items-center gap-1 ${isCalcActive ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-50 hover:text-gray-900'}`}
            aria-haspopup="true"
          >
            Calculators
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>

          <!-- Dropdown panel -->
          <div class="absolute top-full left-1/2 -translate-x-1/2 mt-1 w-[560px] bg-white rounded-xl shadow-lg border border-gray-200 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 p-5">
            <div class="grid grid-cols-3 gap-6">
              <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Loans &amp; Mortgage</p>
                <ul class="space-y-1">
                  {loanCalcs.map(c => (
                    <li>
                      <a href={c.href} class="text-sm text-gray-700 hover:text-primary-600 hover:bg-primary-50 rounded-md px-2 py-1 block transition">
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Savings &amp; Investment</p>
                <ul class="space-y-1">
                  {savingsCalcs.map(c => (
                    <li>
                      <a href={c.href} class="text-sm text-gray-700 hover:text-primary-600 hover:bg-primary-50 rounded-md px-2 py-1 block transition">
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Income &amp; Taxes</p>
                <ul class="space-y-1">
                  {incomeCalcs.map(c => (
                    <li>
                      <a href={c.href} class="text-sm text-gray-700 hover:text-primary-600 hover:bg-primary-50 rounded-md px-2 py-1 block transition">
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>

        <a
          href="/blog"
          class={`px-4 py-2 rounded-md text-sm font-medium transition ${isActive('/blog') ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-50 hover:text-gray-900'}`}
        >
          Blog
        </a>

        <a
          href="/about"
          class={`px-4 py-2 rounded-md text-sm font-medium transition ${isActive('/about') ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-50 hover:text-gray-900'}`}
        >
          About
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 rounded-md text-gray-700 hover:bg-gray-50"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4 space-y-1">
      <a href="/" class={`block px-4 py-2 rounded-md text-base font-medium ${isActive('/') ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-50'}`}>Home</a>

      <!-- Mobile: Loans & Mortgage -->
      <p class="px-4 pt-3 pb-1 text-xs font-semibold text-gray-400 uppercase tracking-wider">Loans &amp; Mortgage</p>
      {loanCalcs.map(c => (
        <a href={c.href} class={`block px-6 py-2 rounded-md text-sm font-medium ${isActive(c.href) ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-50'}`}>{c.label}</a>
      ))}

      <!-- Mobile: Savings & Investment -->
      <p class="px-4 pt-3 pb-1 text-xs font-semibold text-gray-400 uppercase tracking-wider">Savings &amp; Investment</p>
      {savingsCalcs.map(c => (
        <a href={c.href} class={`block px-6 py-2 rounded-md text-sm font-medium ${isActive(c.href) ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-50'}`}>{c.label}</a>
      ))}

      <!-- Mobile: Income & Taxes -->
      <p class="px-4 pt-3 pb-1 text-xs font-semibold text-gray-400 uppercase tracking-wider">Income &amp; Taxes</p>
      {incomeCalcs.map(c => (
        <a href={c.href} class={`block px-6 py-2 rounded-md text-sm font-medium ${isActive(c.href) ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-50'}`}>{c.label}</a>
      ))}

      <div class="border-t border-gray-200 mt-2 pt-2">
        <a href="/blog" class={`block px-4 py-2 rounded-md text-base font-medium ${isActive('/blog') ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-50'}`}>Blog</a>
        <a href="/about" class={`block px-4 py-2 rounded-md text-base font-medium ${isActive('/about') ? 'bg-primary-50 text-primary-700' : 'text-gray-700 hover:bg-gray-50'}`}>About</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
