---
const currentYear = new Date().getFullYear();

const calculators = [
  { href: '/mortgage-calculator',          label: 'Mortgage Calculator' },
  { href: '/loan-calculator',              label: 'Loan Calculator' },
  { href: '/auto-loan-calculator',         label: 'Auto Loan Calculator' },
  { href: '/retirement-calculator',        label: 'Retirement Calculator' },
  { href: '/compound-interest-calculator', label: 'Compound Interest' },
  { href: '/investment-calculator',        label: 'Investment Calculator' },
  { href: '/amortization-calculator',      label: 'Amortization Calculator' },
  { href: '/income-tax-calculator',        label: 'Income Tax Calculator' },
  { href: '/payment-calculator',           label: 'Payment Calculator' },
  { href: '/salary-calculator',            label: 'Salary Calculator' },
];

const resources = [
  { href: '/about',   label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const legal = [
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/terms-of-use',   label: 'Terms of Use' },
  { href: '/disclaimer',     label: 'Disclaimer' },
];
---

<footer class="bg-gray-50 border-t border-gray-200 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">

      <!-- Col 1: Brand -->
      <div>
        <a href="/" class="flex items-center space-x-2 mb-4 hover:opacity-80 transition">
          <div class="w-7 h-7 bg-primary-600 rounded-full flex items-center justify-center flex-shrink-0" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
              <line x1="12" y1="2" x2="12" y2="22"/>
              <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <span class="font-bold text-gray-900">MoneyMathCalc</span>
        </a>
        <p class="text-sm text-gray-600 leading-relaxed">
          Free financial calculators for everyday money decisions. No signup, no paywalls — just clear answers, fast.
        </p>
      </div>

      <!-- Col 2: Calculators -->
      <div>
        <h4 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">Calculators</h4>
        <ul class="space-y-2">
          {calculators.map(link => (
            <li>
              <a href={link.href} class="text-sm text-gray-600 hover:text-primary-600 transition">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Resources -->
      <div>
        <h4 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">Resources</h4>
        <ul class="space-y-2">
          {resources.map(link => (
            <li>
              <a href={link.href} class="text-sm text-gray-600 hover:text-primary-600 transition">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Legal -->
      <div>
        <h4 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">Legal</h4>
        <ul class="space-y-2">
          {legal.map(link => (
            <li>
              <a href={link.href} class="text-sm text-gray-600 hover:text-primary-600 transition">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-gray-200">
      <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4">
        <p class="text-sm text-gray-500">
          &copy; {currentYear} MoneyMathCalc. All rights reserved.
        </p>
        <p class="text-xs text-gray-400 max-w-md">
          Tools for educational purposes only. Not financial advice. Consult a licensed professional for decisions specific to your situation.
        </p>
      </div>
    </div>
  </div>
</footer>
