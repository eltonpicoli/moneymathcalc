---
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Contact MoneyMathCalc";
const description = "Contact MoneyMathCalc with questions, corrections, partnership inquiries, or feedback about our financial calculators.";
const canonical = "https://moneymathcalc.com/contact";

const schemaMarkup = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "name": "Contact MoneyMathCalc",
      "url": canonical,
      "description": description
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://moneymathcalc.com" },
        { "@type": "ListItem", "position": 2, "name": "Contact", "item": canonical }
      ]
    }
  ]
});
---

<Layout title={title} description={description} canonical={canonical} schemaMarkup={schemaMarkup}>
  <Header slot="header" />

  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">Contact</span>
    </nav>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">

      <h1 class="text-3xl font-bold text-gray-900 mb-2">Contact Us</h1>
      <p class="text-gray-600 mb-8">Have a question, spotted an error, or want to discuss a partnership? We'd like to hear from you.</p>

      <form id="contactForm" class="space-y-5" novalidate>

        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
          <input type="text" id="name" name="name" autocomplete="name" required
            class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900"
            placeholder="Jane Smith" />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
          <input type="email" id="email" name="email" autocomplete="email" required
            class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900"
            placeholder="jane@example.com" />
        </div>

        <div>
          <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
          <select id="subject" name="subject"
            class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900">
            <option value="general">General Question</option>
            <option value="correction">Calculator Error / Correction</option>
            <option value="feature">Feature Request</option>
            <option value="partnership">Partnership / Advertising</option>
            <option value="privacy">Privacy Concern</option>
            <option value="other">Other</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
          <textarea id="message" name="message" rows="5" required
            class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900 resize-y"
            placeholder="Describe your question or feedback..."></textarea>
        </div>

        <div id="formError" class="hidden text-red-600 text-sm bg-red-50 border border-red-200 rounded-lg p-3"></div>
        <div id="formSuccess" class="hidden text-green-700 text-sm bg-green-50 border border-green-200 rounded-lg p-3">
          Thanks for reaching out! We'll get back to you within 2 business days.
        </div>

        <button type="submit" id="submitBtn"
          class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-xl transition-colors">
          Send Message
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-gray-100">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">What to Expect</h2>
        <ul class="space-y-2 text-sm text-gray-600">
          <li class="flex items-start gap-2">
            <span class="text-green-500 mt-0.5">✓</span>
            <span>We respond to all messages within 2 business days.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-500 mt-0.5">✓</span>
            <span>Calculator corrections are investigated and deployed quickly — usually within 24 hours of verification.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-500 mt-0.5">✓</span>
            <span>We do not provide personal financial advice. For that, please consult a licensed professional.</span>
          </li>
        </ul>
      </div>
    </div>

  </div>

  <Footer slot="footer" />
</Layout>

<script>
  const form = document.getElementById('contactForm');
  const errEl = document.getElementById('formError');
  const successEl = document.getElementById('formSuccess');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const message = (document.getElementById('message') as HTMLTextAreaElement).value.trim();

    if (!name || !email || !message) {
      errEl.textContent = 'Please fill out all required fields.';
      errEl.classList.remove('hidden');
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errEl.textContent = 'Please enter a valid email address.';
      errEl.classList.remove('hidden');
      return;
    }

    errEl.classList.add('hidden');
    // Form submission would connect to a backend/Formspree/Netlify Forms in production
    // For now, show success state as a static demo
    successEl.classList.remove('hidden');
    form.reset();
    setTimeout(() => successEl.classList.add('hidden'), 8000);
  });
</script>
