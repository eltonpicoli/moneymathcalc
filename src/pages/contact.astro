---
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Contact MoneyMathCalc";
const description = "Contact MoneyMathCalc with questions, corrections, partnership inquiries, or feedback about our financial calculators.";
const canonical = "https://moneymathcalc.com/contact";

const schemaMarkup = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "name": "Contact MoneyMathCalc",
      "url": canonical,
      "description": description
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://moneymathcalc.com" },
        { "@type": "ListItem", "position": 2, "name": "Contact", "item": canonical }
      ]
    }
  ]
});
---

<Layout title={title} description={description} canonical={canonical} schemaMarkup={schemaMarkup}>
  <Header slot="header" />

  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">Contact</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-2">Contact Us</h1>
    <p class="text-gray-600 mb-8">Have a question, spotted an error, or want to discuss a partnership? We'd like to hear from you.</p>

    <!-- Contact Section -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8 mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Get In Touch</h2>

      <p class="text-gray-700 mb-6">
        Have a question, spotted a calculator error, or want to discuss a partnership?
        Send us an email and we'll get back to you within 2 business days.
      </p>

      <a
        href="mailto:contact@moneymathcalc.com?subject=MoneyMathCalc%20Inquiry"
        class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-lg transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"/>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        Email Us at contact@moneymathcalc.com
      </a>

      <p class="text-sm text-gray-500 mt-4">
        Click the button above to open your email client. Or copy our address:
        <span class="font-mono text-gray-700 select-all">contact@moneymathcalc.com</span>
      </p>
    </div>

    <!-- Common Topics -->
    <div class="bg-gray-50 rounded-2xl border border-gray-200 p-6 mb-8">
      <h3 class="font-semibold text-gray-900 mb-3">Common topics we hear about:</h3>
      <ul class="space-y-2 text-gray-700">
        <li>• <strong>Calculator Error / Correction</strong> — found a bug or wrong calculation? Let us know.</li>
        <li>• <strong>Feature Request</strong> — want a new calculator or feature?</li>
        <li>• <strong>Partnership / Advertising</strong> — collaboration opportunities</li>
        <li>• <strong>Privacy Concern</strong> — questions about data handling</li>
        <li>• <strong>General Question</strong> — anything else</li>
      </ul>
    </div>

    <!-- What to Expect -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">
      <h2 class="text-lg font-semibold text-gray-900 mb-3">What to Expect</h2>
      <ul class="space-y-2 text-sm text-gray-600">
        <li class="flex items-start gap-2">
          <span class="text-green-500 mt-0.5">✓</span>
          <span>We respond to all messages within 2 business days.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-green-500 mt-0.5">✓</span>
          <span>Calculator corrections are investigated and deployed quickly — usually within 24 hours of verification.</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-green-500 mt-0.5">✓</span>
          <span>We do not provide personal financial advice. For that, please consult a licensed professional.</span>
        </li>
      </ul>
    </div>

  </div>

  <Footer slot="footer" />
</Layout>
