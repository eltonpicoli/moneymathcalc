---
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Privacy Policy — MoneyMathCalc";
const description = "MoneyMathCalc privacy policy. Learn how we collect, use, and protect information when you use our free financial calculators.";
const canonical = "https://moneymathcalc.com/privacy-policy";
const effectiveDate = "May 14, 2026";

const schemaMarkup = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": "Privacy Policy",
      "url": canonical,
      "description": description,
      "datePublished": "2026-04-22",
      "dateModified": "2026-05-14"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://moneymathcalc.com" },
        { "@type": "ListItem", "position": 2, "name": "Privacy Policy", "item": canonical }
      ]
    }
  ]
});
---

<Layout title={title} description={description} canonical={canonical} schemaMarkup={schemaMarkup}>
  <Header slot="header" />

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">Privacy Policy</span>
    </nav>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-8">

      <h1 class="text-3xl font-bold text-gray-900 mb-2">Privacy Policy</h1>
      <p class="text-sm text-gray-500 mb-8">Effective Date: {effectiveDate}</p>

      <div class="prose prose-gray max-w-none text-gray-700 space-y-6">

        <p>
          MoneyMathCalc ("we," "us," or "our") operates the website moneymathcalc.com. This Privacy Policy explains what information we collect, how we use it, and your rights regarding your data. By using our website, you agree to the practices described here.
        </p>

        <h2 class="text-xl font-bold text-gray-900">1. Information We Collect</h2>

        <h3 class="text-lg font-semibold text-gray-800">Calculator Inputs</h3>
        <p>
          All calculator inputs you enter (loan amounts, income figures, dates, etc.) are processed entirely in your browser. We do not transmit these values to our servers. This data is never stored, logged, or associated with you in any way. When you close the browser tab or navigate away, the data is gone.
        </p>

        <h3 class="text-lg font-semibold text-gray-800">Automatically Collected Information</h3>
        <p>When you visit our website, we automatically collect certain technical information, including:</p>
        <ul class="list-disc pl-5 space-y-1">
          <li>Your device's Internet Protocol (IP) address (anonymized)</li>
          <li>Browser type and version</li>
          <li>Operating system</li>
          <li>Referring website URL</li>
          <li>Pages visited and time spent on pages</li>
          <li>Date and time of each visit</li>
        </ul>
        <p>This information is collected via analytics services (Google Analytics 4 and Cloudflare Web Analytics) and is used in aggregate to understand how our tools are used and how to improve them.</p>

        <h3 class="text-lg font-semibold text-gray-800">Contact Form Submissions</h3>
        <p>
          If you contact us via our contact form, we collect your name, email address, and message. We use this information solely to respond to your inquiry. We do not add you to any marketing lists without your explicit consent.
        </p>

        <h3 class="text-lg font-semibold text-gray-800">Cookies</h3>
        <p>
          We use cookies in the following contexts:
        </p>
        <ul class="list-disc pl-5 space-y-1">
          <li><strong>Analytics cookies:</strong> Google Analytics uses cookies to distinguish users and sessions. You can opt out via Google's opt-out browser add-on or browser privacy settings.</li>
          <li><strong>Session recording cookies:</strong> Microsoft Clarity uses cookies and local storage to record anonymized session data including mouse movements and clicks. You can opt out by enabling "Do Not Track" in your browser or by visiting Microsoft's privacy dashboard at account.microsoft.com/privacy.</li>
          <li><strong>Advertising cookies:</strong> Once we activate Google AdSense, it will use cookies to serve relevant ads. Third-party vendors, including Google, use cookies to serve ads based on your prior visits to this site and other websites. You can opt out of personalized advertising at <a href="https://www.google.com/settings/ads" class="text-blue-600 hover:underline">Google Ads Settings</a> or via the NAI opt-out at aboutads.info.</li>
        </ul>
        <p>
          You can control cookie behavior through your browser settings. Note that disabling cookies may affect some functionality.
        </p>

        <h2 class="text-xl font-bold text-gray-900">2. How We Use Information</h2>
        <p>We use the information we collect to:</p>
        <ul class="list-disc pl-5 space-y-1">
          <li>Operate and improve our website and calculators</li>
          <li>Analyze usage patterns to identify popular features and errors</li>
          <li>Respond to your questions and support requests</li>
          <li>Detect and prevent fraud or abuse</li>
          <li>Comply with legal obligations</li>
        </ul>
        <p>We do not sell your personal information to any third party.</p>

        <h2 class="text-xl font-bold text-gray-900">3. Third-Party Services</h2>
        <p>We use the following third-party services, each with their own privacy policies:</p>
        <ul class="list-disc pl-5 space-y-1">
          <li><strong>Google Analytics 4</strong> — web analytics. Privacy policy: policies.google.com/privacy</li>
          <li><strong>Cloudflare Web Analytics</strong> — privacy-focused analytics, no cookies, no cross-site tracking. Privacy policy: cloudflare.com/privacypolicy/</li>
          <li><strong>Google AdSense</strong> (pending activation) — advertising platform. Privacy policy: policies.google.com/privacy</li>
          <li><strong>Google Fonts</strong> — font delivery via fonts.googleapis.com. Google may log requests per their privacy policy.</li>
          <li><strong>Microsoft Clarity</strong> — behavioral analytics including heatmaps and session recordings. Clarity collects usage data such as mouse movements, clicks, and scroll depth to help us understand how visitors interact with our calculators and improve usability. Data is processed by Microsoft. Privacy policy: privacy.microsoft.com/privacystatement</li>
        </ul>

        <h2 class="text-xl font-bold text-gray-900">4. Data Retention</h2>
        <p>
          Analytics data is retained according to the third-party service's default policies (typically 14 months for Google Analytics). Contact form messages are retained for up to 12 months. We do not retain your calculator inputs because they are never transmitted to us.
        </p>

        <h2 class="text-xl font-bold text-gray-900">5. Your Rights</h2>
        <p>Depending on your location, you may have the right to:</p>
        <ul class="list-disc pl-5 space-y-1">
          <li>Access the personal information we hold about you</li>
          <li>Request correction of inaccurate data</li>
          <li>Request deletion of your data</li>
          <li>Opt out of analytics tracking</li>
          <li>Opt out of personalized advertising</li>
        </ul>
        <p>To exercise any of these rights, contact us via our <a href="/contact" class="text-blue-600 hover:underline">Contact page</a>.</p>

        <h2 class="text-xl font-bold text-gray-900">6. California Residents (CCPA)</h2>
        <p>
          California residents have additional rights under the California Consumer Privacy Act (CCPA). We do not sell personal information. California residents may request to know what personal information we have collected, request deletion, and opt out of sales (not applicable as we do not sell data). Contact us to exercise these rights.
        </p>

        <h2 class="text-xl font-bold text-gray-900">7. Children's Privacy</h2>
        <p>
          Our services are not directed to children under 13. We do not knowingly collect personal information from children under 13. If you believe we have inadvertently collected such information, please contact us immediately.
        </p>

        <h2 class="text-xl font-bold text-gray-900">8. Data Security</h2>
        <p>
          We use industry-standard security measures including HTTPS encryption for all pages. Our hosting (Cloudflare Pages) provides DDoS protection and secure infrastructure. However, no method of transmission over the Internet is 100% secure, and we cannot guarantee absolute security.
        </p>

        <h2 class="text-xl font-bold text-gray-900">9. Links to Other Websites</h2>
        <p>
          Our site may contain links to third-party websites. We are not responsible for the privacy practices of those sites. We encourage you to review their privacy policies before providing any personal information.
        </p>

        <h2 class="text-xl font-bold text-gray-900">10. Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy from time to time. The effective date at the top of this page will reflect the most recent update. Continued use of the site after changes constitutes acceptance of the updated policy.
        </p>

        <h2 class="text-xl font-bold text-gray-900">11. Contact Us</h2>
        <p>
          For privacy-related questions or requests, please visit our <a href="/contact" class="text-blue-600 hover:underline">Contact page</a> and select "Privacy Concern" as the subject.
        </p>

      </div>
    </div>

    <div class="mt-6 text-center text-sm text-gray-400">
      See also: <a href="/terms-of-use" class="text-blue-600 hover:underline">Terms of Use</a> · <a href="/disclaimer" class="text-blue-600 hover:underline">Disclaimer</a>
    </div>

  </div>

  <Footer slot="footer" />
</Layout>
