---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const title = 'Personal Finance Blog | MoneyMathCalc';
const description = 'Practical guides on mortgages, loans, taxes, and retirement planning — written to help you make smarter money decisions with real numbers.';
const canonical = 'https://moneymathcalc.com/blog';

const siteUrl = 'https://moneymathcalc.com';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog` },
      ],
    },
    {
      '@type': 'Blog',
      name: 'MoneyMathCalc Blog',
      description: description,
      url: canonical,
      publisher: {
        '@type': 'Organization',
        '@id': `${siteUrl}/#organization`,
        name: 'MoneyMathCalc',
      },
    },
  ],
});
---

<Layout title={title} description={description} canonical={canonical} schemaMarkup={schema}>
  <Header slot="header" />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Page header -->
    <div class="mb-10">
      <nav class="flex items-center gap-2 text-sm text-gray-500 mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary-600 transition">Home</a>
        <span>/</span>
        <span class="text-gray-700">Blog</span>
      </nav>
      <h1 class="text-4xl font-bold text-gray-900 mb-3">Personal Finance Blog</h1>
      <p class="text-lg text-gray-600 max-w-2xl">
        Practical guides on mortgages, loans, taxes, and retirement — written to help you make smarter money decisions with real numbers.
      </p>
    </div>

    <!-- Post list -->
    {posts.length === 0 ? (
      <p class="text-gray-500">No articles published yet. Check back soon.</p>
    ) : (
      <ul class="space-y-6">
        {posts.map(post => {
          const formattedDate = post.data.publishDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          });
          const dateISO = post.data.publishDate.toISOString().split('T')[0];
          return (
            <li>
              <a
                href={`/blog/${post.slug}`}
                class="block bg-white rounded-xl border border-gray-200 p-6 hover:border-primary-300 hover:shadow-sm transition group"
              >
                <h2 class="text-xl font-semibold text-gray-900 group-hover:text-primary-600 transition mb-2 leading-snug">
                  {post.data.title}
                </h2>
                <p class="text-gray-600 text-sm leading-relaxed mb-3">{post.data.description}</p>
                <p class="text-xs text-gray-400">
                  <time datetime={dateISO}>{formattedDate}</time>
                </p>
              </a>
            </li>
          );
        })}
      </ul>
    )}

    <!-- Internal links -->
    <div class="mt-12 pt-6 border-t border-gray-200">
      <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Our Calculators</p>
      <div class="flex flex-wrap gap-2">
        <a href="/mortgage-calculator" class="text-sm text-primary-600 hover:text-primary-700 bg-primary-50 hover:bg-primary-100 px-3 py-1.5 rounded-full transition">Mortgage</a>
        <a href="/loan-calculator" class="text-sm text-primary-600 hover:text-primary-700 bg-primary-50 hover:bg-primary-100 px-3 py-1.5 rounded-full transition">Loan</a>
        <a href="/retirement-calculator" class="text-sm text-primary-600 hover:text-primary-700 bg-primary-50 hover:bg-primary-100 px-3 py-1.5 rounded-full transition">Retirement</a>
        <a href="/income-tax-calculator" class="text-sm text-primary-600 hover:text-primary-700 bg-primary-50 hover:bg-primary-100 px-3 py-1.5 rounded-full transition">Income Tax</a>
        <a href="/salary-calculator" class="text-sm text-primary-600 hover:text-primary-700 bg-primary-50 hover:bg-primary-100 px-3 py-1.5 rounded-full transition">Salary</a>
      </div>
    </div>

  </div>

  <Footer slot="footer" />
</Layout>
