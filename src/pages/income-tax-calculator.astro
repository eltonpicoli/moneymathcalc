    OR: { brackets: [[0,4050,0.0475],[4050,10200,0.0675],[10200,125000,0.0875],[125000,Infinity,0.099]] },
    PA: { rate: 0.0307 },
    RI: { brackets: [[0,73450,0.0375],[73450,167250,0.0475],[167250,Infinity,0.0599]] },
    SC: { brackets: [[0,3460,0],[3460,6910,0.03],[6910,10380,0.04],[10380,13820,0.05],[13820,Infinity,0.065]] },
    SD: { noTax: true },
    TN: { noTax: true },
    TX: { noTax: true },
    UT: { rate: 0.0465 },
    VT: { brackets: [[0,45400,0.0335],[45400,110050,0.066],[110050,229550,0.076],[229550,Infinity,0.0875]] },
    VA: { brackets: [[0,3000,0.02],[3000,5000,0.03],[5000,17000,0.05],[17000,Infinity,0.0575]] },
    WA: { noTax: true },
    WV: { brackets: [[0,10000,0.0236],[10000,25000,0.0315],[25000,40000,0.0354],[40000,60000,0.0472],[60000,Infinity,0.0512]] },
    WI: { brackets: [[0,14320,0.035],[14320,28640,0.044],[28640,315310,0.053],[315310,Infinity,0.0765]] },
    WY: { noTax: true },
    DC: { brackets: [[0,10000,0.04],[10000,40000,0.06],[40000,60000,0.065],[60000,250000,0.085],[250000,500000,0.0925],[500000,1000000,0.0975],[1000000,Infinity,0.1075]] },
  };

  function calcProgressiveTax(income, brackets) {
    let tax = 0;
    let marginalRate = 0;
    for (const [min, max, rate] of brackets) {
      if (income <= min) break;
      const taxable = Math.min(income, max) - min;
      tax += taxable * rate;
      if (income > min) marginalRate = rate;
    }
    return { tax, marginalRate };
  }

  const fmt = (n) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 0 });
  const fmtPct = (n) => (n * 100).toFixed(1) + '%';

  let viewMode = 'annual'; // 'annual' | 'paycheck'
  let lastResults = null;

  function recalculate() {
    const gross = parseDollar('grossIncome') || 0;
    const status = $('filingStatus').value;
    const state = $('stateSelect').value;
    const payFreq = parseInt($('payFrequency').value) || 26;
    const k401 = parseDollar('k401') || 0;
    const hsa = parseDollar('hsa') || 0;
    const other = parseDollar('otherDeductions') || 0;
    const itemize = $('itemize').checked;
    const itemizedAmt = parseDollar('itemizedAmt') || 0;

    const preTaxDeductions = k401 + hsa + other;
    const agi = Math.max(0, gross - preTaxDeductions);
    const stdDed = STANDARD_DEDUCTIONS[status] || 15000;
    const deduction = itemize ? Math.max(stdDed, itemizedAmt) : stdDed;
    const federalTaxableIncome = Math.max(0, agi - deduction);

    // Federal tax
    const brackets = FEDERAL_BRACKETS[status] || FEDERAL_BRACKETS.single;
    const { tax: federalTax, marginalRate } = calcProgressiveTax(federalTaxableIncome, brackets);

    // FICA
    const ficaWages = gross;
    const ssTax = Math.min(ficaWages, SS_WAGE_BASE) * SS_RATE;
    const medicareTax = ficaWages * MEDICARE_RATE;
    const medicareExtraThreshold = MEDICARE_EXTRA_THRESHOLD[status] || 200000;
    const medicareExtra = Math.max(0, ficaWages - medicareExtraThreshold) * MEDICARE_EXTRA_RATE;
    const totalFica = ssTax + medicareTax + medicareExtra;

    // State tax
    let stateTax = 0;
    const stateData = STATE_TAX[state];
    if (stateData && !stateData.noTax) {
      // Most states: use AGI - state standard deduction
      // Simplification: use federal deduction for all states (conservative)
      const stateTaxableIncome = Math.max(0, agi - (stateData.useGross ? 0 : deduction));
      if (stateData.brackets) {
        const { tax } = calcProgressiveTax(stateTaxableIncome, stateData.brackets);
        stateTax = tax;
      } else if (stateData.rate) {
        stateTax = stateTaxableIncome * stateData.rate;
      }
      // NH: no wage income tax
      if (state === 'NH') stateTax = 0;
    }

    const totalTax = federalTax + totalFica + stateTax;
    const takeHome = gross - totalTax - preTaxDeductions;
    const effectiveRate = gross > 0 ? totalTax / gross : 0;

    lastResults = {
      gross, preTaxDeductions, agi, deduction, federalTaxableIncome,
      federalTax, ssTax, medicareTax, medicareExtra, totalFica,
      stateTax, totalTax, takeHome, effectiveRate, marginalRate,
      stdDed, payFreq, status, brackets, state
    };

    renderResults(lastResults);
    updateURL(lastResults);
  }

  function getMultiplier() {
    if (!lastResults) return 1;
    return viewMode === 'paycheck' ? 1 / lastResults.payFreq : 1;
  }

  function renderResults(r) {
    const m = getMultiplier();
    const labelStr = viewMode === 'paycheck' ? `Per Paycheck (÷${r.payFreq})` : 'Annual';

    // Header cards
    setText('res-takehome', fmt(r.takeHome * m));
    setText('res-totaltax', fmt(r.totalTax * m));
    setText('res-effectiverate', fmtPct(r.effectiveRate));
    setText('res-marginalrate', (r.marginalRate * 100).toFixed(0) + '%');
    setText('viewLabel', labelStr);
    setText('amtHeader', viewMode === 'paycheck' ? 'Per Paycheck' : 'Annual Amount');

    // Sidebar
    setText('side-gross', fmt(r.gross * m));
    setText('side-pretax', fmt(-r.preTaxDeductions * m));
    setText('side-stdded', fmt(-r.deduction * m));
    setText('side-taxable', fmt(r.federalTaxableIncome * m));
    setText('side-federal', '−' + fmt(r.federalTax * m));
    setText('side-state', '−' + fmt(r.stateTax * m));
    setText('side-fica', '−' + fmt(r.totalFica * m));
    setText('side-takehome', fmt(r.takeHome * m));

    // Pie chart segments
    const segments = [
      { label: 'Federal Tax', value: r.federalTax, color: '#EF4444' },
      { label: 'State Tax', value: r.stateTax, color: '#F97316' },
      { label: 'Social Security', value: r.ssTax, color: '#EAB308' },
      { label: 'Medicare', value: r.medicareTax + r.medicareExtra, color: '#8B5CF6' },
      { label: 'Take-Home', value: r.takeHome, color: '#10B981' },
    ].filter(s => s.value > 0);
    renderPie(segments, r.gross);

    // Tax table
    const tbody = document.getElementById('taxTableBody');
    if (tbody) {
      tbody.innerHTML = [
        { label: 'Federal Income Tax', rate: r.federalTaxableIncome > 0 ? fmtPct(r.federalTax / r.gross) : '0%', amount: r.federalTax },
        { label: 'Social Security (6.2%)', rate: '6.2%', amount: r.ssTax },
        { label: 'Medicare (1.45%)', rate: '1.45%', amount: r.medicareTax },
        ...(r.medicareExtra > 0 ? [{ label: 'Medicare Surtax (0.9%)', rate: '0.9%', amount: r.medicareExtra }] : []),
        { label: `State Income Tax (${r.state})`, rate: r.gross > 0 ? fmtPct(r.stateTax / r.gross) : '0%', amount: r.stateTax },
        { label: 'Total Tax', rate: fmtPct(r.effectiveRate), amount: r.totalTax, bold: true },
      ].map(row => `
        <tr class="${row.bold ? 'bg-gray-50 border-t-2 border-gray-200 font-semibold' : 'hover:bg-gray-50'}">
          <td class="py-3 text-gray-700">${row.label}</td>
          <td class="py-3 text-right text-gray-500">${row.rate}</td>
          <td class="py-3 text-right font-mono text-gray-900">${fmt(row.amount * m)}</td>
        </tr>
      `).join('');
    }

    // Federal bracket detail
    const bDetail = document.getElementById('bracketDetail');
    if (bDetail) {
      let html = '';
      let remaining = r.federalTaxableIncome;
      for (const [min, max, rate] of r.brackets) {
        if (remaining <= 0) break;
        const taxable = Math.min(remaining, max - min);
        const tax = taxable * rate;
        const pctOfGross = r.gross > 0 ? (tax / r.gross * 100).toFixed(1) : 0;
        const barWidth = Math.min(100, (taxable / (r.gross || 1)) * 100);
        html += `
          <div class="flex items-center gap-3 text-sm">
            <div class="w-16 text-right font-medium text-gray-700">${(rate * 100).toFixed(0)}%</div>
            <div class="flex-1 bg-gray-100 rounded-full h-2">
              <div class="bg-red-400 h-2 rounded-full" style="width: ${barWidth}%"></div>
            </div>
            <div class="w-28 text-right font-mono text-gray-600">${fmt(taxable)} taxed</div>
            <div class="w-20 text-right font-mono text-red-600">= ${fmt(tax)}</div>
          </div>
        `;
        remaining -= taxable;
      }
      bDetail.innerHTML = html || '<p class="text-gray-400 text-sm">No taxable income after deductions.</p>';
    }
  }

  function renderPie(segments, total) {
    const svg = document.getElementById('taxPie');
    const legend = document.getElementById('pieLegend');
    if (!svg || !legend) return;

    const cx = 90, cy = 90, r = 75;
    let startAngle = -Math.PI / 2;
    let paths = '';

    for (const seg of segments) {
      const angle = (seg.value / total) * 2 * Math.PI;
      const endAngle = startAngle + angle;
      const x1 = cx + r * Math.cos(startAngle);
      const y1 = cy + r * Math.sin(startAngle);
      const x2 = cx + r * Math.cos(endAngle);
      const y2 = cy + r * Math.sin(endAngle);
      const largeArc = angle > Math.PI ? 1 : 0;
      paths += `<path d="M ${cx} ${cy} L ${x1} ${y1} A ${r} ${r} 0 ${largeArc} 1 ${x2} ${y2} Z" fill="${seg.color}" opacity="0.85" />`;
      startAngle = endAngle;
    }

    svg.innerHTML = paths;

    legend.innerHTML = segments.map(seg => {
      const pct = total > 0 ? (seg.value / total * 100).toFixed(1) : 0;
      return `
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full flex-shrink-0" style="background: ${seg.color}"></div>
          <span class="text-gray-700 flex-1">${seg.label}</span>
          <span class="font-mono text-gray-600 text-xs">${pct}%</span>
        </div>
      `;
    }).join('');
  }

  function updateURL(r) {
    const url = new URL(window.location.href);
    url.searchParams.set('income', r.gross);
    url.searchParams.set('status', r.status);
    url.searchParams.set('state', r.state);
    window.history.replaceState({}, '', url.toString());
  }

  // Load from URL
  const params = new URLSearchParams(window.location.search);
  if (params.get('income')) {
    const el = $('grossIncome');
    if (el) el.value = parseInt(params.get('income')).toLocaleString('en-US');
  }
  if (params.get('status')) {
    const el = $('filingStatus');
    if (el) el.value = params.get('status');
  }
  if (params.get('state')) {
    const el = $('stateSelect');
    if (el) el.value = params.get('state');
  }

  // View toggle
  $('viewAnnual')?.addEventListener('click', () => {
    viewMode = 'annual';
    $('viewAnnual').className = 'flex-1 py-2.5 text-sm font-medium bg-blue-600 text-white transition-colors';
    $('viewPaycheck').className = 'flex-1 py-2.5 text-sm font-medium bg-white text-gray-700 hover:bg-gray-50 transition-colors';
    if (lastResults) renderResults(lastResults);
  });
  $('viewPaycheck')?.addEventListener('click', () => {
    viewMode = 'paycheck';
    $('viewPaycheck').className = 'flex-1 py-2.5 text-sm font-medium bg-blue-600 text-white transition-colors';
    $('viewAnnual').className = 'flex-1 py-2.5 text-sm font-medium bg-white text-gray-700 hover:bg-gray-50 transition-colors';
    if (lastResults) renderResults(lastResults);
  });

  // Itemize toggle
  $('itemize')?.addEventListener('change', () => {
    const box = document.getElementById('itemizeInput');
    if (box) box.classList.toggle('hidden', !$('itemize').checked);
    recalculate();
  });

  // Events
  $('calcBtn')?.addEventListener('click', recalculate);
  ['grossIncome','filingStatus','stateSelect','payFrequency','k401','hsa','otherDeductions','itemizedAmt'].forEach(id => {
    $(id)?.addEventListener('blur', recalculate);
    $(id)?.addEventListener('change', recalculate);
  });

  function doShare() {
    navigator.clipboard.writeText(window.location.href).then(() => {
      ['shareBtn', 'shareBtn2'].forEach(id => {
        const b = $(id); if (!b) return;
        const orig = b.textContent;
        b.textContent = 'Link Copied!';
        setTimeout(() => { b.textContent = orig; }, 2000);
      });
    });
  }
  $('shareBtn')?.addEventListener('click', doShare);
  $('shareBtn2')?.addEventListener('click', doShare);
  $('btn-pdf2')?.addEventListener('click', () => $('btn-pdf')?.click());

  // Dollar formatting — reformat input value on blur using the element ID
  ['grossIncome','k401','hsa','otherDeductions','itemizedAmt'].forEach(id => {
    $(id)?.addEventListener('blur', () => {
      const val = parseDollar(id);
      const el = $(id);
      if (!isNaN(val) && val > 0 && el) el.value = Math.round(val).toLocaleString('en-US');
    });
  });

  // PDF Export
  $('btn-pdf')?.addEventListener('click', async () => {
    if (!lastResults) return;
    const btn = $('btn-pdf') as HTMLButtonElement | null;
    if (btn) btn.textContent = 'Generating…';
    try {
      const { jsPDF } = await import('jspdf');
      const r = lastResults;
      const doc = new jsPDF();
      const dateStr = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
      const statusLabels: Record<string, string> = { single: 'Single', mfj: 'Married Filing Jointly', hoh: 'Head of Household', mfs: 'Married Filing Separately' };

      doc.setFontSize(20); doc.setTextColor(0, 82, 204);
      doc.text('Income Tax Estimate', 20, 25);
      doc.setFontSize(9); doc.setTextColor(120, 120, 120);
      doc.text('MoneyMathCalc.com  —  Free Financial Calculators', 20, 33);
      doc.text(`Generated: ${dateStr}`, 20, 39);

      let y = 52;
      doc.setFontSize(12); doc.setTextColor(30, 30, 30); doc.text('Your Tax Details', 20, y); y += 8; doc.setFontSize(10);
      const payFreqLabel: Record<number, string> = { 52: 'Weekly', 26: 'Biweekly', 24: 'Semi-Monthly', 12: 'Monthly', 1: 'Annually' };
      ([['Gross Income', fmt(r.gross)], ['Filing Status', statusLabels[r.status] || r.status], ['State', r.state],
        ['Pay Frequency', payFreqLabel[r.payFreq] || `${r.payFreq}×/year`],
        ...(r.preTaxDeductions > 0 ? [['Pre-Tax Deductions', fmt(r.preTaxDeductions)]] : []),
        ['Standard Deduction', fmt(r.stdDed)], ['Federal Taxable Income', fmt(r.federalTaxableIncome)]] as [string,string][]).forEach(([l,v]) => {
        doc.setTextColor(100,100,100); doc.text(l+':', 20, y); doc.setTextColor(30,30,30); doc.text(v, 95, y); y += 7;
      });

      y += 4; doc.setFontSize(12); doc.text('Results Summary', 20, y); y += 8; doc.setFontSize(10);
      ([['Take-Home Pay (Annual)', fmt(r.takeHome)], ['Federal Income Tax', fmt(r.federalTax)],
        ['Social Security Tax', fmt(r.ssTax)], ['Medicare Tax', fmt(r.medicareTax + r.medicareExtra)],
        ['State Income Tax', fmt(r.stateTax)], ['Total Tax', fmt(r.totalTax)],
        ['Effective Tax Rate', fmtPct(r.effectiveRate)], ['Marginal Tax Rate', (r.marginalRate * 100).toFixed(0) + '%']] as [string,string][]).forEach(([l,v]) => {
        doc.setTextColor(100,100,100); doc.text(l+':', 20, y); doc.setTextColor(30,30,30); doc.text(v, 95, y); y += 7;
      });

      if (r.payFreq > 1) {
        y += 4; doc.setFontSize(12); doc.text(`Per Paycheck Breakdown (÷${r.payFreq})`, 20, y); y += 8; doc.setFontSize(10);
        const p = r.payFreq;
        ([['Gross Pay Per Paycheck', fmt(r.gross/p)], ['Federal Tax Per Paycheck', fmt(r.federalTax/p)],
          ['FICA Per Paycheck', fmt(r.totalFica/p)], ['State Tax Per Paycheck', fmt(r.stateTax/p)],
          ['Take-Home Per Paycheck', fmt(r.takeHome/p)]] as [string,string][]).forEach(([l,v]) => {
          doc.setTextColor(100,100,100); doc.text(l+':', 20, y); doc.setTextColor(30,30,30); doc.text(v, 95, y); y += 7;
        });
      }

      y += 6; if (y > 230) { doc.addPage(); y = 20; }
      doc.setFontSize(12); doc.setTextColor(30,30,30); doc.text('Federal Tax Bracket Breakdown', 20, y); y += 8;
      doc.setFontSize(9); doc.setTextColor(120,120,120);
      ['Bracket','Income in Bracket','Tax'].forEach((h,i) => doc.text(h,[20,55,140][i], y));
      y += 4; doc.setDrawColor(200,200,200); doc.line(20, y, 190, y); y += 4; doc.setTextColor(30,30,30);
      let remaining = r.federalTaxableIncome;
      for (const [min, max, rate] of r.brackets) {
        if (remaining <= 0) break;
        const taxable = Math.min(remaining, max - min);
        const tax = taxable * rate;
        if (y > 248) { doc.addPage(); y = 20; }
        [`${(rate*100).toFixed(0)}% bracket`, fmt(taxable), fmt(tax)].forEach((v,i) => doc.text(String(v),[20,55,140][i], y));
        y += 6;
        remaining -= taxable;
      }

      await addPdfFooter(doc, window.location.href, 'Income Tax Estimate');
      doc.save('income-tax-estimate.pdf');
    } finally {
      if (btn) btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" width="14" height="14"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg> Save as PDF';
    }
  });

  recalculate();
</script>
