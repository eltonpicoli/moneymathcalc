---
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Income Tax Calculator 2026 — Federal + State Taxes";
const description = "Calculate your 2026 federal and state income tax. Includes FICA, all 50 states, filing status, 401k/HSA deductions. See annual and per-paycheck breakdown.";
const canonical = "https://moneymathcalc.com/income-tax-calculator";

const schemaMarkup = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Income Tax Calculator 2026",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web",
      "url": canonical,
      "description": description,
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://moneymathcalc.com" },
        { "@type": "ListItem", "position": 2, "name": "Income Tax Calculator", "item": canonical }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are the 2026 federal income tax brackets?",
          "acceptedAnswer": { "@type": "Answer", "text": "For 2026, the federal tax brackets for a single filer are: 10% on income up to $11,925; 12% from $11,926–$48,475; 22% from $48,476–$103,350; 24% from $103,351–$197,300; 32% from $197,301–$250,525; 35% from $250,526–$626,350; 37% over $626,350. These are applied progressively after the standard deduction." }
        },
        {
          "@type": "Question",
          "name": "What is the standard deduction for 2026?",
          "acceptedAnswer": { "@type": "Answer", "text": "The 2026 standard deduction is $15,000 for single filers, $30,000 for married filing jointly, and $22,500 for head of household. These amounts reflect IRS inflation adjustments from the 2026 tax year." }
        },
        {
          "@type": "Question",
          "name": "How is FICA tax calculated?",
          "acceptedAnswer": { "@type": "Answer", "text": "FICA consists of Social Security (6.2% on wages up to $176,100 in 2026) and Medicare (1.45% on all wages, plus an additional 0.9% on wages exceeding $200,000 for single filers). Your employer pays a matching 6.2% + 1.45% on their end." }
        },
        {
          "@type": "Question",
          "name": "Does a 401k contribution reduce my taxable income?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Traditional 401k contributions (up to $23,500 in 2026) reduce your federal and state taxable income dollar-for-dollar. This means if you're in the 22% bracket, a $5,000 contribution saves $1,100 in federal tax. HSA contributions also reduce taxable income and are triple-tax advantaged." }
        },
        {
          "@type": "Question",
          "name": "Which states have no income tax?",
          "acceptedAnswer": { "@type": "Answer", "text": "As of 2026, nine states have no state income tax: Alaska, Florida, Nevada, New Hampshire (taxes only investment income), South Dakota, Tennessee, Texas, Washington (taxes capital gains over $262,000), and Wyoming." }
        },
        {
          "@type": "Question",
          "name": "What is the effective tax rate vs marginal tax rate?",
          "acceptedAnswer": { "@type": "Answer", "text": "Your marginal rate is the rate applied to your last dollar of income — your top bracket. Your effective rate is total taxes paid divided by total income. At $60,000 single, you might be in the 22% marginal bracket but only pay an 11–12% effective federal rate because lower brackets apply to the first portions of income." }
        },
        {
          "@type": "Question",
          "name": "How much should I withhold from each paycheck for taxes?",
          "acceptedAnswer": { "@type": "Answer", "text": "Your employer withholds based on your W-4 form. To avoid a large bill or refund, your total withholding should equal your total annual tax liability. Use this calculator to find your annual tax, then divide by your pay periods to verify your per-paycheck withholding matches." }
        }
      ]
    }
  ]
});
---

<Layout title={title} description={description} canonical={canonical} schemaMarkup={schemaMarkup}>
  <Header slot="header" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-600">Home</a>
      <span>/</span>
      <span class="text-gray-900 font-medium">Income Tax Calculator</span>
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-2">Income Tax Calculator 2026</h1>
    <p class="text-gray-600 mb-2">Estimate your federal and state income taxes — including FICA, deductions, and per-paycheck breakdown.</p>

    <!-- Disclaimer banner -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 mb-6 text-sm text-yellow-800">
      <strong>Educational tool only.</strong> Results are estimates based on 2026 IRS tax tables. Actual taxes depend on your full financial situation. Consult a tax professional for filing decisions.
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- Calculator -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 mb-6 p-6">

          <h2 class="text-lg font-semibold text-gray-900 mb-5">Your Tax Information</h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
            <!-- Gross Income -->
            <div class="sm:col-span-2">
              <label class="block text-sm font-medium text-gray-700 mb-1">Gross Annual Income</label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 font-medium">$</span>
                <input id="grossIncome" type="text" inputmode="decimal" value="75,000"
                  class="w-full pl-7 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-900 text-lg font-semibold" />
              </div>
            </div>

            <!-- Filing Status -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Filing Status</label>
              <select id="filingStatus"
                class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-gray-900">
                <option value="single">Single</option>
                <option value="mfj">Married Filing Jointly</option>
                <option value="hoh">Head of Household</option>
                <option value="mfs">Married Filing Separately</option>
              </select>
            </div>

            <!-- State -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">State</label>
              <select id="stateSelect"
                class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-gray-900">
                <option value="AL">Alabama</option>
                <option value="AK">Alaska (No Tax)</option>
                <option value="AZ">Arizona</option>
                <option value="AR">Arkansas</option>
                <option value="CA">California</option>
                <option value="CO">Colorado</option>
                <option value="CT">Connecticut</option>
                <option value="DE">Delaware</option>
                <option value="FL">Florida (No Tax)</option>
                <option value="GA">Georgia</option>
                <option value="HI">Hawaii</option>
                <option value="ID">Idaho</option>
                <option value="IL">Illinois</option>
                <option value="IN">Indiana</option>
                <option value="IA">Iowa</option>
                <option value="KS">Kansas</option>
                <option value="KY">Kentucky</option>
                <option value="LA">Louisiana</option>
                <option value="ME">Maine</option>
                <option value="MD">Maryland</option>
                <option value="MA">Massachusetts</option>
                <option value="MI">Michigan</option>
                <option value="MN">Minnesota</option>
                <option value="MS">Mississippi</option>
                <option value="MO">Missouri</option>
                <option value="MT">Montana</option>
                <option value="NE">Nebraska</option>
                <option value="NV">Nevada (No Tax)</option>
                <option value="NH">New Hampshire</option>
                <option value="NJ">New Jersey</option>
                <option value="NM">New Mexico</option>
                <option value="NY" selected>New York</option>
                <option value="NC">North Carolina</option>
                <option value="ND">North Dakota</option>
                <option value="OH">Ohio</option>
                <option value="OK">Oklahoma</option>
                <option value="OR">Oregon</option>
                <option value="PA">Pennsylvania</option>
                <option value="RI">Rhode Island</option>
                <option value="SC">South Carolina</option>
                <option value="SD">South Dakota (No Tax)</option>
                <option value="TN">Tennessee</option>
                <option value="TX">Texas (No Tax)</option>
                <option value="UT">Utah</option>
                <option value="VT">Vermont</option>
                <option value="VA">Virginia</option>
                <option value="WA">Washington</option>
                <option value="WV">West Virginia</option>
                <option value="WI">Wisconsin</option>
                <option value="WY">Wyoming (No Tax)</option>
                <option value="DC">Washington D.C.</option>
              </select>
            </div>

            <!-- Pay frequency -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Pay Frequency</label>
              <select id="payFrequency"
                class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-gray-900">
                <option value="52">Weekly (52×/yr)</option>
                <option value="26" selected>Biweekly (26×/yr)</option>
                <option value="24">Semi-Monthly (24×/yr)</option>
                <option value="12">Monthly (12×/yr)</option>
              </select>
            </div>

            <!-- View toggle -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">View Results As</label>
              <div class="flex rounded-lg overflow-hidden border border-gray-300">
                <button id="viewAnnual" class="flex-1 py-2.5 text-sm font-medium bg-blue-600 text-white transition-colors">Annual</button>
                <button id="viewPaycheck" class="flex-1 py-2.5 text-sm font-medium bg-white text-gray-700 hover:bg-gray-50 transition-colors">Per Paycheck</button>
              </div>
            </div>
          </div>

          <!-- Deductions (advanced) -->
          <details class="mb-4">
            <summary class="text-sm text-blue-600 font-medium cursor-pointer hover:text-blue-700 select-none">+ Deductions: 401k, HSA, Other</summary>
            <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-4 p-4 bg-gray-50 rounded-lg border border-gray-200">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Traditional 401k / 403b</label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">$</span>
                  <input id="k401" type="text" inputmode="decimal" value="0"
                    class="w-full pl-7 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="0" />
                </div>
                <p class="text-xs text-gray-400 mt-1">2026 limit: $23,500</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">HSA Contribution</label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">$</span>
                  <input id="hsa" type="text" inputmode="decimal" value="0"
                    class="w-full pl-7 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="0" />
                </div>
                <p class="text-xs text-gray-400 mt-1">2026 limit: $4,300 (self-only)</p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Other Pre-Tax Deductions</label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">$</span>
                  <input id="otherDeductions" type="text" inputmode="decimal" value="0"
                    class="w-full pl-7 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="0" />
                </div>
                <p class="text-xs text-gray-400 mt-1">Health insurance premiums, FSA, etc.</p>
              </div>
              <div class="flex items-center gap-3">
                <input id="itemize" type="checkbox" class="w-4 h-4 rounded border-gray-300 text-blue-600" />
                <label for="itemize" class="text-sm text-gray-700">Itemize deductions (enter total below)</label>
              </div>
              <div id="itemizeInput" class="hidden">
                <label class="block text-sm font-medium text-gray-700 mb-1">Total Itemized Deductions</label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">$</span>
                  <input id="itemizedAmt" type="text" inputmode="decimal" value="0"
                    class="w-full pl-7 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" placeholder="0" />
                </div>
              </div>
            </div>
          </details>

          <button id="calcBtn"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-xl transition-colors">
            Calculate Taxes
          </button>
          <div class="flex flex-wrap gap-3 mt-3">
            <button id="shareBtn2" class="flex items-center gap-2 px-4 py-2 border border-gray-300 rounded-lg text-sm text-gray-700 hover:border-primary-400 hover:text-primary-600 transition">
              🔗 Share Result
            </button>
            <button id="btn-pdf2" class="flex items-center gap-2 px-4 py-2 border border-gray-300 rounded-lg text-sm text-gray-700 hover:border-primary-600 hover:text-primary-600 transition">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" width="14" height="14"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
              Save as PDF
            </button>
          </div>
        </div>

        <!-- Results -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 mb-6 p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-gray-900">Tax Breakdown</h2>
            <span id="viewLabel" class="text-sm text-gray-500 bg-gray-100 px-2 py-1 rounded">Annual</span>
          </div>

          <!-- Key results -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
            <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-center">
              <div id="res-takehome" class="text-2xl font-bold font-mono text-green-700">$52,850</div>
              <div class="text-xs text-green-600 mt-1">Take-Home Pay</div>
            </div>
            <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-center">
              <div id="res-totaltax" class="text-2xl font-bold font-mono text-red-600">$22,150</div>
              <div class="text-xs text-red-500 mt-1">Total Tax</div>
            </div>
            <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-center">
              <div id="res-effectiverate" class="text-2xl font-bold font-mono text-blue-700">29.5%</div>
              <div class="text-xs text-blue-600 mt-1">Effective Rate</div>
            </div>
            <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-center">
              <div id="res-marginalrate" class="text-2xl font-bold font-mono text-gray-700">22%</div>
              <div class="text-xs text-gray-500 mt-1">Marginal Rate</div>
            </div>
          </div>

          <!-- Pie Chart -->
          <div class="flex flex-col sm:flex-row items-center gap-6 mb-6">
            <div class="flex-shrink-0">
              <svg id="taxPie" width="180" height="180" viewBox="0 0 180 180"></svg>
            </div>
            <div id="pieLegend" class="flex-1 space-y-2 text-sm w-full">
              <!-- populated by JS -->
            </div>
          </div>

          <!-- Detailed breakdown table -->
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200">
                <th class="text-left py-2 text-gray-600 font-medium">Tax</th>
                <th class="text-right py-2 text-gray-600 font-medium">Rate</th>
                <th class="text-right py-2 text-gray-600 font-medium" id="amtHeader">Annual Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100" id="taxTableBody">
              <!-- populated by JS -->
            </tbody>
          </table>
        </div>

        <!-- Federal brackets detail -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 mb-6 p-6">
          <h2 class="text-lg font-semibold text-gray-900 mb-3">Federal Tax Bracket Detail</h2>
          <p class="text-sm text-gray-500 mb-3">How your income is taxed across each bracket:</p>
          <div id="bracketDetail" class="space-y-2 text-sm">
            <!-- populated by JS -->
          </div>
        </div>

        <!-- Ad slot -->
        <div class="bg-gray-100 border border-dashed border-gray-300 rounded-xl p-4 text-center text-gray-400 text-sm mb-6" data-ad-slot="in-article-1">
          Advertisement
        </div>

        <!-- Educational content -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 mb-6 prose prose-gray max-w-none">
          <h2 class="text-xl font-bold text-gray-900 mb-3">How Federal Income Taxes Work in 2026</h2>
          <p class="text-gray-700">
            The US federal income tax system is <strong>progressive</strong>: you pay different rates on different portions of your income, not a single flat rate on everything. This is the most misunderstood aspect of American taxes, and it's why your "tax bracket" doesn't mean all your income is taxed at that rate.
          </p>
          <p class="text-gray-700">
            For example, if you're a single filer earning $75,000 in 2026: first subtract the $15,000 standard deduction, leaving $60,000 taxable income. The first $11,925 is taxed at 10%, the next $36,550 at 12%, and the remaining $11,525 at 22%. Your marginal rate is 22%, but your effective federal rate is roughly 13%.
          </p>

          <h3 class="text-lg font-semibold text-gray-900 mt-5 mb-2">2026 Federal Tax Brackets (Single Filer)</h3>
          <table class="w-full text-sm border border-gray-200 rounded-lg overflow-hidden">
            <thead class="bg-gray-50">
              <tr>
                <th class="text-left p-3 font-semibold text-gray-700">Rate</th>
                <th class="text-right p-3 font-semibold text-gray-700">Taxable Income</th>
                <th class="text-right p-3 font-semibold text-gray-700">Tax on Bracket</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <tr><td class="p-3">10%</td><td class="p-3 text-right font-mono">$0 – $11,925</td><td class="p-3 text-right font-mono">up to $1,193</td></tr>
              <tr><td class="p-3">12%</td><td class="p-3 text-right font-mono">$11,926 – $48,475</td><td class="p-3 text-right font-mono">up to $4,386</td></tr>
              <tr><td class="p-3">22%</td><td class="p-3 text-right font-mono">$48,476 – $103,350</td><td class="p-3 text-right font-mono">up to $12,073</td></tr>
              <tr><td class="p-3">24%</td><td class="p-3 text-right font-mono">$103,351 – $197,300</td><td class="p-3 text-right font-mono">up to $22,536</td></tr>
              <tr><td class="p-3">32%</td><td class="p-3 text-right font-mono">$197,301 – $250,525</td><td class="p-3 text-right font-mono">up to $17,030</td></tr>
              <tr><td class="p-3">35%</td><td class="p-3 text-right font-mono">$250,526 – $626,350</td><td class="p-3 text-right font-mono">up to $131,578</td></tr>
              <tr><td class="p-3">37%</td><td class="p-3 text-right font-mono">Over $626,350</td><td class="p-3 text-right font-mono">37% on excess</td></tr>
            </tbody>
          </table>
          <p class="text-xs text-gray-400 mt-1">Source: IRS Rev. Proc. 2025-61 (projected 2026 inflation-adjusted brackets)</p>

          <h2 class="text-xl font-bold text-gray-900 mt-6 mb-3">FICA: Social Security and Medicare</h2>
          <p class="text-gray-700">
            FICA taxes fund Social Security and Medicare and are separate from income tax. They're applied before any deductions, on every dollar of earned income (wages and self-employment income).
          </p>
          <ul class="list-disc pl-5 text-gray-700 space-y-1">
            <li><strong>Social Security:</strong> 6.2% on wages up to $176,100 (2026 wage base). Capped at $10,918/year.</li>
            <li><strong>Medicare:</strong> 1.45% on all wages. Plus an additional 0.9% on wages over $200,000 (single) / $250,000 (MFJ).</li>
          </ul>
          <p class="text-gray-700 mt-2">
            Your employer matches the 6.2% Social Security and 1.45% Medicare on their end. Self-employed individuals pay both halves (15.3%) but can deduct the employer half.
          </p>

          <h2 class="text-xl font-bold text-gray-900 mt-6 mb-3">Standard vs. Itemized Deductions</h2>
          <p class="text-gray-700">
            Before calculating tax, you reduce your income by either the standard deduction or your itemized deductions — whichever is larger. The 2026 standard deductions are:
          </p>
          <ul class="list-disc pl-5 text-gray-700 space-y-1">
            <li><strong>Single:</strong> $15,000</li>
            <li><strong>Married Filing Jointly:</strong> $30,000</li>
            <li><strong>Head of Household:</strong> $22,500</li>
            <li><strong>Married Filing Separately:</strong> $15,000</li>
          </ul>
          <p class="text-gray-700 mt-2">
            Itemized deductions include mortgage interest, charitable contributions, state/local taxes (capped at $10,000), and unreimbursed medical expenses over 7.5% of AGI. Most taxpayers take the standard deduction since the 2018 Tax Cuts and Jobs Act nearly doubled standard amounts.
          </p>

          <h2 class="text-xl font-bold text-gray-900 mt-6 mb-3">Pre-Tax Deductions: Your Best Tax Tool</h2>
          <p class="text-gray-700">
            Pre-tax contributions to a traditional 401k, 403b, HSA, or FSA reduce your <em>taxable</em> income — lowering both federal and state income tax. The 2026 contribution limits are:
          </p>
          <ul class="list-disc pl-5 text-gray-700 space-y-1">
            <li><strong>401k/403b:</strong> $23,500 ($31,000 if age 50+, with catch-up)</li>
            <li><strong>HSA (self-only):</strong> $4,300; (family) $8,550</li>
            <li><strong>FSA:</strong> $3,300</li>
          </ul>
          <p class="text-gray-700 mt-2">
            If you're in the 22% federal bracket and contribute $10,000 to a 401k, you save $2,200 in federal tax, plus state tax savings on top. The contribution isn't free money — you'll pay taxes when you withdraw in retirement — but the deferral compounds meaningfully over decades.
          </p>

          <h2 class="text-xl font-bold text-gray-900 mt-6 mb-3">State Income Taxes</h2>
          <p class="text-gray-700">
            State income taxes vary enormously. California tops the chart at a 13.3% top rate. Nine states — including Texas, Florida, and Nevada — collect no state income tax at all. Most states conform to the federal standard deduction, though some have their own deduction structures.
          </p>
          <p class="text-gray-700">
            For states with flat rates, the calculation is simple: multiply your state taxable income by the flat rate. Progressive states use their own bracket tables. Our calculator applies each state's 2026 brackets or flat rates for an accurate estimate.
          </p>
        </div>

        <!-- Ad slot 2 -->
        <div class="bg-gray-100 border border-dashed border-gray-300 rounded-xl p-4 text-center text-gray-400 text-sm mb-6" data-ad-slot="in-article-2">
          Advertisement
        </div>

        <!-- FAQs -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 mb-6">
          <h2 class="text-xl font-bold text-gray-900 mb-4">Frequently Asked Questions</h2>
          <div class="space-y-5">

            <div>
              <h3 class="font-semibold text-gray-900 mb-1">What are the 2026 federal income tax brackets?</h3>
              <p class="text-gray-600 text-sm">For single filers: 10% up to $11,925; 12% to $48,475; 22% to $103,350; 24% to $197,300; 32% to $250,525; 35% to $626,350; 37% above that. Applied progressively after the $15,000 standard deduction.</p>
            </div>

            <div>
