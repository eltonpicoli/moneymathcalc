---
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  publishDate: Date;
  updatedDate?: Date;
}

const { title, description, canonical, publishDate, updatedDate } = Astro.props;

const siteUrl = 'https://moneymathcalc.com';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description: description,
      url: canonical,
      datePublished: publishDate.toISOString(),
      dateModified: (updatedDate ?? publishDate).toISOString(),
      publisher: {
        '@type': 'Organization',
        '@id': `${siteUrl}/#organization`,
        name: 'MoneyMathCalc',
        url: `${siteUrl}/`,
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonical,
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog` },
        { '@type': 'ListItem', position: 3, name: title, item: canonical },
      ],
    },
  ],
});

const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const dateISO = publishDate.toISOString().split('T')[0];
---

<Layout
  title={`${title} | MoneyMathCalc`}
  description={description}
  canonical={canonical}
  schemaMarkup={schema}
>
  <Header slot="header" />

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary-600 transition">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:text-primary-600 transition">Blog</a>
      <span>/</span>
      <span class="text-gray-700 truncate">{title}</span>
    </nav>

    <article>
      <header class="mb-8 pb-6 border-b border-gray-200">
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 leading-tight mb-3">{title}</h1>
        <p class="text-gray-500 text-sm">
          Published <time datetime={dateISO}>{formattedDate}</time>
        </p>
      </header>

      <div class="prose prose-gray max-w-none prose-a:text-primary-600 prose-a:no-underline hover:prose-a:text-primary-700 prose-headings:text-gray-900">
        <slot />
      </div>

      <!-- Internal links footer -->
      <div class="mt-12 pt-6 border-t border-gray-200">
        <p class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-3">Related Calculators</p>
        <div class="flex flex-wrap gap-2">
          <a href="/mortgage-calculator" class="text-sm text-primary-600 hover:text-primary-700 bg-primary-50 hover:bg-primary-100 px-3 py-1.5 rounded-full transition">Mortgage Calculator</a>
          <a href="/loan-calculator" class="text-sm text-primary-600 hover:text-primary-700 bg-primary-50 hover:bg-primary-100 px-3 py-1.5 rounded-full transition">Loan Calculator</a>
          <a href="/amortization-calculator" class="text-sm text-primary-600 hover:text-primary-700 bg-primary-50 hover:bg-primary-100 px-3 py-1.5 rounded-full transition">Amortization Calculator</a>
        </div>
      </div>
    </article>

  </div>

  <Footer slot="footer" />
</Layout>

